{
  "name": "novaformation-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server for NovaFormation: read and write programs, books, exercises, objectives, XP and statistics.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supabase/supabase-js": "2.112.0",
    "date-fns": "4.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
