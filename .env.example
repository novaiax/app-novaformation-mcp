# NovaFormation's Supabase project (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key: server-side only, never expose it to a browser
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the NovaFormation user to act as (defaults to the app's single account)
NOVAFORMATION_USER_ID=

# Token clients must send (Authorization: Bearer <token> or ?token=<token>). Empty = open server.
MCP_AUTH_TOKEN=

MCP_HOST=0.0.0.0
MCP_PORT=8080
# Public base URL, only used in the startup log
MCP_PUBLIC_URL=
